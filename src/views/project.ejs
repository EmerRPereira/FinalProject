<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>

    <% if (categories && categories.length > 0) { %>
        <div class="category-tags">
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>" class="tag">
                    <%= category.name %>
                </a>
            <% }) %>
        </div>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <p>
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a> |
            <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
        </p>
    <% } %>

    <p><strong>Description:</strong> <%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>

    <%# W06: Volunteer functionality (only for logged-in users) %>
    <% if (isLoggedIn) { %>
        <hr>
        <h3>Volunteer</h3>
        <% if (userIsVolunteer) { %>
            <p><strong>You are volunteering for this project.</strong></p>
            <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                <button type="submit">Remove Me as Volunteer</button>
            </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit">Volunteer for this Project</button>
            </form>
        <% } %>
    <% } %>
</main>

<%- include('partials/footer') %>